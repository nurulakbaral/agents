{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "high",
            "planModeReasoningEffort": "high",
            "sandboxMode": "workspace-write",
            "approvalPolicy": "on-request",
            "approvalReviewer": "user"
          }
        }
      }
    }
  },
  "autoupdate": true,
  "server": {
    "port": 4096,
  },
}
